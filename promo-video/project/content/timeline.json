    {
      "id": 1,
      "scene_id": 1,
      "start": 0.163577,
      "end": 2.780807,
      "role": "opening",
      "text": "大家好，这是开源软件 Word2Sentence。"
    },
    {
      "id": 2,
      "scene_id": 1,
      "start": 3.026172,
      "end": 6.379498,
      "role": "opening",
      "text": "程序本身免费使用，源码公开在 GitHub，也欢迎大家改进。"
    },
    {
      "id": 3,
      "scene_id": 2,
      "start": 6.870229,
      "end": 10.223555,
      "role": "transition",
      "text": "它要解决的是，明明背过单词，真正造句时却仍会卡住。"
    },
    {
      "id": 4,
      "scene_id": 2,
      "start": 10.46892,
      "end": 14.721919,
      "role": "problem",
      "text": "知道 distract 的意思，轮到自己写句子时，却还是想不起常见搭配。"
    },
    {
      "id": 5,
      "scene_id": 2,
      "start": 14.967284,
      "end": 19.38386,
      "role": "inference",
      "text": "只看释义，往往还发现不了词形和搭配的问题。"
    },
    {
      "id": 6,
      "scene_id": 3,
      "start": 19.95638,
      "end": 23.391494,
      "role": "transition",
      "text": "因此，练习从你加入词库的生词开始。"
    },
    {
      "id": 7,
      "scene_id": 3,
      "start": 23.63686,
      "end": 27.889858,
      "role": "setup",
      "text": "启用 AI 后，它会给出具体情境，但不会提前写出完整答案。"
    },
    {
      "id": 8,
      "scene_id": 3,
      "start": 28.135224,
      "end": 32.470011,
      "role": "proof",
      "text": "你会在这个情境里，自己写下一句想表达的话。"
    },
    {
      "id": 9,
      "scene_id": 4,
      "start": 33.124318,
      "end": 36.968375,
      "role": "transition",
      "text": "句子提交以后，系统会先标出各部分的表达质量。"
    },
    {
      "id": 10,
      "scene_id": 4,
      "start": 37.21374,
      "end": 41.221374,
      "role": "explanation",
      "text": "绿色表示表达自然，蓝色表示可以优化，红色表示有错误。"
