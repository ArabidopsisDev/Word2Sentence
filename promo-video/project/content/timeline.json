  "cues": [
    {"id": 1, "scene_id": 1, "start": 0.3, "end": 3.9, "role": "opening", "text": "大家好，Word2Sentence 是一款开源的单词学习软件。"},
    {"id": 2, "scene_id": 1, "start": 4.2, "end": 8.1, "role": "opening", "text": "程序本身免费使用，源码公开在 GitHub，也欢迎大家改进。"},
    {"id": 3, "scene_id": 2, "start": 8.9, "end": 12.4, "role": "transition", "text": "它要解决的是，明明背过单词，真正造句时却仍会卡住。"},
    {"id": 4, "scene_id": 2, "start": 12.7, "end": 16.6, "role": "problem", "text": "知道 distract 的意思，轮到自己写句子时，却还是想不起常见搭配。"},
    {"id": 5, "scene_id": 2, "start": 16.9, "end": 20.3, "role": "inference", "text": "释义只告诉你大概含义，造句会暴露词形和搭配的问题。"},
    {"id": 6, "scene_id": 3, "start": 20.9, "end": 24.3, "role": "transition", "text": "因此，练习从你加入词库的生词开始。"},
    {"id": 7, "scene_id": 3, "start": 24.6, "end": 29.2, "role": "setup", "text": "启用 AI 后，它会给出具体情境，但不会提前写出完整答案。"},
    {"id": 8, "scene_id": 3, "start": 29.5, "end": 35.6, "role": "proof", "text": "你会在这个情境里，自己写下一句想表达的话。"},
    {"id": 9, "scene_id": 4, "start": 36.5, "end": 39.7, "role": "transition", "text": "句子提交以后，系统会先标出各部分的表达质量。"},
    {"id": 10, "scene_id": 4, "start": 40.0, "end": 43.3, "role": "explanation", "text": "绿色表示表达自然，蓝色表示可以优化，红色表示有错误。"},
    {"id": 11, "scene_id": 4, "start": 43.6, "end": 47.2, "role": "proof", "text": "系统会同时保留两个版本，一个只改错误，一个表达更自然。"},
    {"id": 12, "scene_id": 4, "start": 47.5, "end": 51.3, "role": "proof", "text": "常用搭配会整理成一条条用法卡，同步到首页。"},
    {"id": 13, "scene_id": 4, "start": 51.6, "end": 55.6, "role": "boundary", "text": "其他掌握不好的词会先列出来，只有你确认后才加入词库。"},
    {"id": 14, "scene_id": 5, "start": 56.5, "end": 59.8, "role": "transition", "text": "这些表现还会影响下一次复习的时间。"},
    {"id": 15, "scene_id": 5, "start": 60.1, "end": 63.8, "role": "explanation", "text": "系统会检查拼写、词义、词形、搭配和句中的语法。"},
    {"id": 16, "scene_id": 5, "start": 64.1, "end": 67.6, "role": "explanation", "text": "提示、粘贴、作答时间和修改次数，也会影响判断。"},
    {"id": 17, "scene_id": 5, "start": 67.9, "end": 71.5, "role": "explanation", "text": "证据可信且一致时，本地规则会先映射为内部等级。"},
    {"id": 18, "scene_id": 5, "start": 71.8, "end": 75.0, "role": "proof", "text": "再由 FSRS-6 计算下一次复习时间。"},
    {"id": 19, "scene_id": 5, "start": 75.3, "end": 79.6, "role": "boundary", "text": "证据冲突时，系统会在十分钟后复测，不改动长期状态。"},
    {"id": 20, "scene_id": 5, "start": 79.9, "end": 83.3, "role": "boundary", "text": "界面没有自评按钮，复习时间来自做题时的实际表现。"},
    {"id": 21, "scene_id": 6, "start": 84.0, "end": 87.2, "role": "transition", "text": "完整词库和历史默认保存在本机。"},
    {"id": 22, "scene_id": 6, "start": 87.5, "end": 91.7, "role": "boundary", "text": "启用 AI 时，目标词、备注和当前练习会通过 OpenRouter 发送。"},
    {"id": 23, "scene_id": 6, "start": 92.0, "end": 96.1, "role": "boundary", "text": "这些内容和最近几条同词情境，还会交给所选模型提供方。"},
    {"id": 24, "scene_id": 6, "start": 96.4, "end": 101.5, "role": "boundary", "text": "界面、学习目标和 AI 解释语言可以分别设置，英语只是演示。"},
    {"id": 25, "scene_id": 7, "start": 102.7, "end": 108.5, "role": "summary", "text": "如果你也常常认识一个词却不会用，就从写下一句想表达的话开始。"}
  ]
}
