  "cues": [
    {
      "id": 1,
      "scene_id": 1,
      "start": 0.163577,
      "end": 2.290076,
      "role": "opening",
      "text": "欢迎认识 Word2Sentence。"
    },
    {
      "id": 2,
      "scene_id": 1,
      "start": 2.453653,
      "end": 4.74373,
      "role": "opening",
      "text": "免费使用，源码公开。"
    },
    {
      "id": 3,
      "scene_id": 2,
      "start": 5.970556,
      "end": 8.178844,
      "role": "transition",
      "text": "背过单词，造句时却还是会卡住。"
    },
    {
      "id": 4,
      "scene_id": 2,
      "start": 8.342421,
      "end": 10.796074,
      "role": "problem",
      "text": "知道 distract 的意思，却不会搭配。"
    },
    {
      "id": 5,
      "scene_id": 2,
      "start": 10.959651,
      "end": 13.65867,
      "role": "inference",
      "text": "只看释义，往往还发现不了词形和搭配的问题。"
    },
    {
      "id": 6,
      "scene_id": 3,
      "start": 15.948746,
      "end": 19.220284,
      "role": "transition",
      "text": "因此，练习从你加入词库的生词开始。"
    },
    {
      "id": 7,
      "scene_id": 3,
      "start": 19.383861,
      "end": 23.064341,
      "role": "setup",
      "text": "启用 AI 后，它会给出具体情境，但不会提前写出完整答案。"
    },
    {
      "id": 8,
      "scene_id": 3,
      "start": 23.227917,
      "end": 27.562705,
      "role": "proof",
      "text": "你会在这个情境里，自己写下一句想表达的话。"
    },
    {
      "id": 9,
      "scene_id": 4,
      "start": 28.217012,
      "end": 31.48855,
      "role": "transition",
      "text": "句子提交以后，系统会先标出各部分的表达质量。"
    },
    {
      "id": 10,
      "scene_id": 4,
      "start": 31.733915,
      "end": 35.16903,
      "role": "explanation",
      "text": "绿色表示表达自然，蓝色表示可以优化，红色表示有错误。"
    },
    {
      "id": 11,
      "scene_id": 4,
      "start": 35.414395,
      "end": 39.258452,
      "role": "proof",
      "text": "系统保留两个版本，一个纠正错误，另一个表达更自然。"
    },
    {
      "id": 12,
      "scene_id": 4,
      "start": 39.503817,
      "end": 42.938932,
      "role": "proof",
      "text": "常用搭配会整理成一条条用法卡，同步到首页。"
    },
    {
      "id": 13,
      "scene_id": 4,
      "start": 43.184297,
      "end": 47.110142,
      "role": "boundary",
      "text": "句子里其他可能没掌握的词，会先列出，确认后才加入词库。"
    },
    {
      "id": 14,
      "scene_id": 5,
      "start": 49.400218,
      "end": 52.181025,
      "role": "transition",
      "text": "系统根据这次表现，自动安排下次复习。"
    },
    {
      "id": 17,
      "scene_id": 5,
      "start": 52.344602,
      "end": 55.452562,
      "role": "explanation",
      "text": "答得越稳，这个词通常会晚一些再出现。"
    },
    {
      "id": 20,
      "scene_id": 5,
      "start": 55.616139,
      "end": 58.642312,
      "role": "boundary",
      "text": "系统自动判断，不需要你自己选择好、中、差。"
    },
    {
      "id": 26,
      "scene_id": 6,
      "start": 59.214831,
      "end": 62.159215,
      "role": "transition",
      "text": "每一次造句，也会留下可以回看的学习轨迹。"
    },
    {
      "id": 27,
      "scene_id": 6,
      "start": 62.322792,
      "end": 65.430752,
      "role": "proof",
      "text": "打卡、连胜、练习量和平均分，会随历史自动更新。"
    },
    {
      "id": 28,
      "scene_id": 6,
      "start": 65.594329,
      "end": 69.274809,
      "role": "inference",
      "text": "覆盖率、稳定掌握率和待巩固词，会直接指出下一步。"
    },
    {
      "id": 21,
      "scene_id": 7,
      "start": 69.765539,
      "end": 71.646673,
      "role": "transition",
      "text": "词库和历史默认保存在本机。"
    },
    {
      "id": 22,
      "scene_id": 7,
      "start": 71.81025,
      "end": 73.854961,
      "role": "boundary",
      "text": "AI 可不启用，只发送当前练习文本。"
    },
    {
      "id": 24,
      "scene_id": 7,
      "start": 74.018538,
      "end": 75.981461,
      "role": "boundary",
      "text": "界面和学习语言可以分别设置。"
    },
    {
      "id": 25,
      "scene_id": 8,
      "start": 76.308615,
      "end": 79.989095,
      "role": "summary",
      "text": "项目地址就在画面中，欢迎从一个生词开始。"
    }
