  "cues": [
    {
      "id": 1,
      "scene_id": 1,
      "start": 0.245365,
      "end": 3.925845,
      "role": "opening",
      "text": "大家好，Word2Sentence 是一款开源的单词学习软件。"
    },
    {
      "id": 2,
      "scene_id": 1,
      "start": 4.17121,
      "end": 9.569248,
      "role": "opening",
      "text": "程序本身免费使用，源码公开在 GitHub，也欢迎大家改进。"
    },
    {
      "id": 3,
      "scene_id": 2,
      "start": 10.141767,
      "end": 13.495093,
      "role": "transition",
      "text": "它要解决的是，明明背过单词，真正造句时却仍会卡住。"
    },
    {
      "id": 4,
      "scene_id": 2,
      "start": 13.740458,
      "end": 17.993457,
      "role": "problem",
      "text": "知道 distract 的意思，轮到自己写句子时，却还是想不起常见搭配。"
    },
    {
      "id": 5,
      "scene_id": 2,
      "start": 18.238822,
      "end": 22.655398,
      "role": "inference",
      "text": "只看释义，往往还发现不了词形和搭配的问题。"
    },
    {
      "id": 6,
      "scene_id": 3,
      "start": 23.227917,
      "end": 26.663031,
      "role": "transition",
      "text": "因此，练习从你加入词库的生词开始。"
    },
    {
      "id": 7,
      "scene_id": 3,
      "start": 26.908397,
      "end": 31.161395,
      "role": "setup",
      "text": "启用 AI 后，它会给出具体情境，但不会提前写出完整答案。"
    },
    {
      "id": 8,
      "scene_id": 3,
      "start": 31.406761,
      "end": 35.741548,
      "role": "proof",
      "text": "你会在这个情境里，自己写下一句想表达的话。"
    },
    {
      "id": 9,
      "scene_id": 4,
      "start": 36.395856,
      "end": 40.239913,
      "role": "transition",
      "text": "句子提交以后，系统会先标出各部分的表达质量。"
    },
    {
      "id": 10,
      "scene_id": 4,
      "start": 40.485278,
      "end": 44.492912,
      "role": "explanation",
      "text": "绿色表示表达自然，蓝色表示可以优化，红色表示有错误。"
    },
    {
      "id": 11,
      "scene_id": 4,
      "start": 44.738277,
      "end": 49.073064,
      "role": "proof",
      "text": "系统保留两个版本，一个纠正错误，另一个表达更自然。"
    },
    {
      "id": 12,
      "scene_id": 4,
      "start": 49.31843,
      "end": 53.980371,
      "role": "proof",
      "text": "常用搭配会整理成一条条用法卡，同步到首页。"
    },
    {
      "id": 13,
      "scene_id": 4,
      "start": 54.225736,
      "end": 60.932388,
      "role": "boundary",
      "text": "句子里其他可能没掌握的词，会先列出，确认后才加入词库。"
    },
    {
      "id": 14,
      "scene_id": 5,
      "start": 62.486369,
      "end": 66.08506,
      "role": "transition",
      "text": "系统会根据这次造句的表现，自动安排下一次复习。"
    },
    {
      "id": 17,
      "scene_id": 5,
      "start": 66.330425,
      "end": 70.583424,
      "role": "explanation",
      "text": "答得越稳，这个词通常会晚一些再出现。"
    },
    {
      "id": 20,
      "scene_id": 5,
      "start": 70.82879,
      "end": 75.0,
      "role": "boundary",
      "text": "系统自动判断，不需要你自己选择好、中、差。"
    },
    {
      "id": 21,
      "scene_id": 6,
      "start": 75.572519,
      "end": 78.516903,
      "role": "transition",
      "text": "完整词库和历史默认保存在本机。"
    },
    {
      "id": 22,
      "scene_id": 6,
      "start": 78.762268,
      "end": 81.78844,
      "role": "boundary",
      "text": "AI 可以不启用；启用时只发送当前练习所需文本。"
    },
    {
      "id": 24,
      "scene_id": 6,
      "start": 82.033806,
      "end": 84.814613,
      "role": "boundary",
      "text": "界面和学习语言可以分别设置，英语只是演示。"
    },
    {
      "id": 25,
      "scene_id": 7,
      "start": 85.387132,
      "end": 90.785169,
      "role": "summary",
      "text": "前往 GitHub 下载 Word2Sentence，从一个生词、一句话开始。"
    }
  ]
