<Window x:Class="Word2Sentence.WordSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Word2Sentence.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc DialogTitle}" Width="680" Height="560" MinWidth="580" MinHeight="440"
        Icon="Assets/Word2Sentence.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStyle="None" Background="{StaticResource CanvasBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CandidateCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                    BorderBrush="#A9AAA5" Background="White" VerticalAlignment="Top" Margin="0,2,0,0">
                                <TextBlock x:Name="Check" Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F1EFEA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <Image Source="Assets/Word2Sentence.ico" Width="22" Height="22" SnapsToDevicePixels="True" />
                    <TextBlock Margin="9,0,0,0" Text="{loc:Loc DialogTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click" />
            </Grid>
        </Border>

    <Grid Grid.Row="1" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Eyebrow}" Text="{loc:Loc DialogEyebrow}" />
            <TextBlock Margin="0,6,0,5" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="25" FontWeight="SemiBold" Text="{loc:Loc DialogHeading}" />
            <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Text="{loc:Loc DialogDescription}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="CandidateCountText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,6" Content="{loc:Loc SelectAll}" Click="SelectAll_Click" />
            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Padding="12,6" Content="{loc:Loc SelectNone}" Click="SelectNone_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Background="#F2F0EA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CandidateList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="14" CornerRadius="7" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <CheckBox Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="CandidateCheckChanged" Unchecked="CandidateCheckChanged">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Error.Word}" FontSize="16" FontWeight="SemiBold" />
                                            <Border Margin="9,0,0,0" Padding="7,2" CornerRadius="9" Background="{StaticResource BlueSoftBrush}">
                                                <TextBlock Text="{Binding Error.PartOfSpeech}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BlueBrush}" />
                                            </Border>
                                            <TextBlock Margin="10,2,0,0" Text="{Binding Error.CorrectionLabel}" FontSize="11"
                                                       Foreground="{StaticResource RedBrush}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Error.Meaning}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Error.Reason}" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                       Text="{loc:Loc NothingUnchecked}" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:Loc Skip}" Click="Skip_Click" />
            <Button Grid.Column="3" x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{loc:Loc AddSelected}" Click="Confirm_Click" />
        </Grid>
    </Grid>
    </Grid>
</Window>
